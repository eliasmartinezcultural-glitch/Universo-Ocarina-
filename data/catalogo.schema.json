{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasmartinezcultural-glitch.github.io/Universo-Ocarina-/data/catalogo.schema.json",
  "title": "Catálogo público de Universo Ocarina",
  "type": "object",
  "required": ["schema_version", "project", "categories", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "project": {
      "type": "object",
      "required": ["name", "description", "maintainer"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "maintainer": {"type": "string", "minLength": 1},
        "last_reviewed": {"type": "string", "format": "date"}
      }
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "number": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "categories", "summary", "status", "visibility"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^oca-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["documental", "video", "fotografia", "audio", "radio", "programa", "sitio-web", "aplicacion", "videojuego", "mapa", "texto", "documento", "investigacion", "otro"]},
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["audiovisual", "radio", "tecnologia", "escritos", "territorio"]}
          },
          "summary": {"type": "string", "maxLength": 500},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "thumbnail": {"type": "string"},
          "date": {"type": "string"},
          "author": {"type": "string"},
          "collaborators": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["draft", "review", "published", "archived"]},
          "visibility": {"type": "string", "enum": ["public", "private"]}
        }
      }
    }
  }
}